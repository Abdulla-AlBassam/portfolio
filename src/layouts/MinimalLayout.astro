---
import Socials from "@/components/Socials.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
  title: string;
  description?: string;
  active: "about" | "projects" | "photography" | "skills" | "thoughts";
  sidebarTop?: string;
  sidebarBottom?: string;
  /** Absolute URL of a share image (og:image). */
  image?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = "Cybersecurity.",
  active,
  sidebarTop = "18rem",
  sidebarBottom = "38rem",
  image,
  ogType = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { id: "about", label: "About", href: "/" },
  { id: "projects", label: "Projects", href: "/projects" },
  { id: "skills", label: "Skills & Certs", href: "/skills" },
  { id: "thoughts", label: "Thoughts", href: "/thoughts" },
  { id: "photography", label: "Photography", href: "/photography" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        // Dark is the default; the page only goes light when the visitor has
        // chosen it. The class is added first so a storage failure still
        // lands on dark. System preference is intentionally ignored.
        document.documentElement.classList.add("dark");
        try {
          if (localStorage.getItem("theme") === "light") {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="627" />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <slot name="head" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script defer src="https://cloud.umami.is/script.js" data-website-id="8c977691-5137-4260-bd4b-9abd81c35a1a"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="brand">
      <h1 class="signature-mark">
        <a href="/" class="signature-link" aria-label="Home – Abdulla AlBassam">
          <img
            src="/signature.webp"
            alt="Abdulla AlBassam"
            class="signature signature-en"
            width="1288"
            height="273"
          />
          <svg class="signature-divider" viewBox="0 0 24 56" aria-hidden="true">
            <path
              d="M 14 4 C 6 12, 18 20, 10 28 C 4 36, 16 44, 8 52"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <img
            src="/signature-ar.webp"
            alt="عبدالله البسام"
            class="signature signature-ar"
            width="1387"
            height="211"
          />
        </a>
      </h1>

      <div class="brand-actions">
        <ThemeToggle class="header-theme" />
        <button
          class="menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label="Open menu"
        >
          <span class="menu-lines" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
      <div class="menu-top">
        <a href="/" class="signature-link" aria-label="Home – Abdulla AlBassam">
          <img
            src="/signature.webp"
            alt="Abdulla AlBassam"
            class="signature signature-en"
            width="1288"
            height="273"
          />
        </a>
        <div class="brand-actions">
          <ThemeToggle class="header-theme" />
          <button class="menu-close" type="button" aria-label="Close menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <line x1="5" y1="5" x2="19" y2="19" />
              <line x1="19" y1="5" x2="5" y2="19" />
            </svg>
          </button>
        </div>
      </div>

      <nav class="menu-nav" aria-label="Sections">
        <ul>
          {
            nav.map((item) => (
              <li class:list={[{ active: item.id === active }]}>
                <a href={item.href} aria-current={item.id === active ? "page" : undefined}>
                  <span class="dot" aria-hidden="true" />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="menu-foot">
        <Socials />
      </div>
    </div>

    <div class="frame">
      <aside class="sidebar" aria-label="Section navigation">
        <ul>
          <li class="theme-li">
            <ThemeToggle class="sidebar-theme" />
          </li>
          {
            nav.map((item) => (
              <li class:list={[{ active: item.id === active }]}>
                <a href={item.href} aria-current={item.id === active ? "page" : undefined}>
                  <span class="dot" aria-hidden="true" />
                  <span class="label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <slot name="sidebar-inline" />
      </aside>

      <main class="content">
        <slot />
      </main>

      <div class="sidebar-extra-slot" style={`--extra-offset: ${sidebarTop}`}>
        <slot name="sidebar-extra" />
      </div>

      <div class="sidebar-extra-slot sidebar-extra-bottom" style={`--extra-offset: ${sidebarBottom}`}>
        <slot name="sidebar-extra-bottom" />
      </div>

      {
        Astro.slots.has("aside-right") && (
          <div class="aside-right-slot">
            <slot name="aside-right" />
          </div>
        )
      }
    </div>

    <footer class="site-footer">
      <p class="copy">
        © {year} Abdulla AlBassam <span class="sep" aria-hidden="true">·</span>
        <span class="v1-wrap">
          <a href="/showcase" class="v1-link">v1</a>
          <svg class="v1-arrow" viewBox="0 0 90 56" aria-hidden="true">
            <path
              d="M 78 50 C 64 54, 50 50, 42 42 C 34 34, 36 24, 44 24 C 51 24, 50 36, 40 32 C 28 30, 16 32, 6 28"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M 12 22 L 6 28 L 12 34"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </p>
      <div class="socials-wrap">
        <svg class="socials-arrow" viewBox="0 0 90 56" aria-hidden="true">
          <path
            d="M 12 50 C 26 54, 40 50, 48 42 C 56 34, 54 24, 46 24 C 39 24, 40 36, 50 32 C 62 30, 74 32, 84 28"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M 78 22 L 84 28 L 78 34"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <Socials />
      </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      const root = document.documentElement;
      // One toggle per surface: sidebar, mobile header and the open menu.
      const themeToggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

      function syncThemeToggle() {
        const isDark = root.classList.contains("dark");
        themeToggles.forEach((btn) => {
          btn.setAttribute("aria-pressed", String(isDark));
          btn.setAttribute(
            "aria-label",
            isDark ? "Switch to light mode" : "Switch to dark mode",
          );
        });
      }

      syncThemeToggle();

      themeToggles.forEach((btn) => {
        btn.addEventListener("click", () => {
          const isDark = root.classList.toggle("dark");
          try {
            localStorage.setItem("theme", isDark ? "dark" : "light");
          } catch (e) {}
          syncThemeToggle();
        });
      });

      const menu = document.getElementById("site-menu");
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
      const menuClose = menu?.querySelector<HTMLButtonElement>(".menu-close");
      const outside = [".brand", ".frame", ".site-footer"].map((sel) =>
        document.querySelector<HTMLElement>(sel),
      );
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let lastFocus: HTMLElement | null = null;

      function setInert(on: boolean) {
        outside.forEach((el) => {
          if (el) el.inert = on;
        });
      }

      // Safari paints a focus ring on any scripted focus(), so focus is only
      // moved when the trigger itself was reached by keyboard.
      function openMenu(byKeyboard: boolean) {
        if (!menu || !menuButton || menu.hidden === false) return;
        lastFocus = document.activeElement as HTMLElement;
        menu.hidden = false;
        void menu.offsetHeight; // commit the display change before the transition
        menu.classList.add("is-open");
        menuButton.setAttribute("aria-expanded", "true");
        menuButton.setAttribute("aria-label", "Close menu");
        root.classList.add("menu-open");
        setInert(true);
        if (byKeyboard) menuClose?.focus();
      }

      function closeMenu(byKeyboard: boolean) {
        if (!menu || !menuButton || menu.hidden) return;
        menu.classList.remove("is-open");
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.setAttribute("aria-label", "Open menu");
        root.classList.remove("menu-open");
        setInert(false);
        const finish = () => {
          menu.hidden = true;
        };
        // Above the breakpoint the overlay is display:none, so no transition will
        // run and transitionend would never arrive to reset hidden.
        if (reduceMotion || getComputedStyle(menu).display === "none") {
          finish();
        } else {
          menu.addEventListener("transitionend", function onEnd(ev) {
            if (ev.target !== menu) return; // ignore the staggered list items
            menu.removeEventListener("transitionend", onEnd);
            finish();
          });
        }
        if (byKeyboard) (lastFocus ?? menuButton).focus();
      }

      menuButton?.addEventListener("click", () => {
        const byKeyboard = menuButton.matches(":focus-visible");
        menu?.hidden ? openMenu(byKeyboard) : closeMenu(byKeyboard);
      });
      menuClose?.addEventListener("click", () => closeMenu(menuClose.matches(":focus-visible")));

      document.addEventListener("keydown", (e) => {
        if (!menu || menu.hidden) return;
        if (e.key === "Escape") {
          e.preventDefault();
          closeMenu(true);
          return;
        }
        if (e.key === "Tab") {
          // Fallback trap for browsers without inert.
          const focusable = Array.from(
            menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
          );
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      // Growing past the breakpoint would otherwise leave the page scroll-locked
      // behind an overlay that is no longer shown.
      window.matchMedia("(min-width: 861px)").addEventListener("change", (e) => {
        if (e.matches) closeMenu(false);
      });

      const toast = document.getElementById("toast");
      let toastTimeout: number | undefined;

      function showToast(message: string) {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add("show");
        if (toastTimeout) window.clearTimeout(toastTimeout);
        toastTimeout = window.setTimeout(() => toast.classList.remove("show"), 1800);
      }

      document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const email = btn.dataset.copyEmail;
          if (!email) return;
          try {
            await navigator.clipboard.writeText(email);
            showToast("Copied to clipboard");
          } catch {
            showToast("Couldn’t copy – long-press the icon");
          }
        });
      });
    </script>

    <style is:global>
      :root {
        --font-serif: "Newsreader", "Iowan Old Style", "Palatino Linotype",
          "Book Antiqua", "Charter", Georgia, "Times New Roman", serif;
        --pampas: #f4f3ee;
        --pampas-deep: #ece9e0;
        --midnight: #272757;
        --midnight-soft: #45459a;
        --cloudy: #b1ada1;
        --cloudy-deep: #8c8a82;
        --ink: #1a1816;
        --ink-soft: #3a3733;
        --rule: #d8d4c8;
      }

      html.dark {
        --pampas: #262320;
        --pampas-deep: #302c28;
        /* Same hue, lifted to sit on the dark page. */
        --midnight: #9a9ee0;
        --midnight-soft: #b9bcee;
        --cloudy: #4a443d;
        --cloudy-deep: #a39d92;
        --ink: #f2efe7;
        --ink-soft: #d8d3c8;
        --rule: #38332e;
      }

      /* The signature is pure line-art, so flip its ink to show on the dark page.
         Photos, portraits and the spot illustrations are left as-is on purpose. */
      html.dark .signature {
        filter: invert(1) hue-rotate(180deg);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 95%;
        font-optical-sizing: auto;
      }

      /* Scroll lock while the mobile menu is open; the overlay scrolls itself. */
      html.menu-open {
        overflow: hidden;
      }

      body {
        background: var(--pampas);
        color: var(--ink);
        font-family: var(--font-serif);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        min-height: 100vh;
      }

      a {
        color: var(--midnight);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        transition: color 0.15s ease;
      }

      a:hover {
        color: var(--midnight-soft);
      }

      p {
        margin: 0 0 1.1em 0;
      }

      h1, h2, h3 {
        font-family: var(--font-serif);
        color: var(--ink);
      }
    </style>

    <style>
      .brand {
        text-align: center;
        padding: 3rem 1.5rem 0;
      }

      /* Indented to sit on the nav's dot column. The toggle is a child
         component, so its classes are reached through :global(). */
      .sidebar :global(.sidebar-theme) {
        padding-left: 0.9rem;
      }

      /* Toggle and menu button share the header's right edge below the
         breakpoint; the sidebar carries the toggle above it. */
      .brand-actions {
        display: none;
      }

      .signature-mark {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        margin: 0;
        line-height: 1;
      }

      .signature-link {
        display: inline-flex;
        align-items: center;
        gap: 1.25rem;
        text-decoration: none;
        color: inherit;
        border-radius: 4px;
        transition: opacity 0.15s ease;
      }

      .signature-link:hover {
        opacity: 0.7;
      }

      .signature-link:focus-visible {
        outline: 2px solid var(--midnight);
        outline-offset: 6px;
      }

      .signature {
        display: block;
        height: 44px;
        width: auto;
        user-select: none;
        pointer-events: none;
      }

      .signature-ar {
        height: 38px;
      }

      .signature-divider {
        display: inline-block;
        width: 16px;
        height: 44px;
        color: var(--midnight);
        flex-shrink: 0;
        overflow: visible;
      }

      .frame {
        display: grid;
        grid-template-columns: 180px minmax(0, 580px);
        gap: 3rem;
        max-width: 880px;
        margin: 0 auto;
        padding: 3rem 2rem 4rem;
        position: relative;
        min-height: 32rem;
      }

      .sidebar {
        position: sticky;
        top: 3rem;
        align-self: start;
        z-index: 2;
        background: var(--pampas);
      }

      .sidebar ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }

      .sidebar a {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.15rem 0;
        font-family: var(--font-serif);
        font-size: 0.95rem;
        letter-spacing: 0.005em;
        color: var(--cloudy-deep);
        text-decoration: none;
        transition: color 0.15s ease;
      }

      .sidebar a:hover {
        color: var(--midnight);
      }

      .sidebar .dot {
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 50%;
        background: transparent;
        flex-shrink: 0;
        transition: background 0.2s ease;
      }

      .sidebar li.active .dot {
        background: var(--midnight);
      }

      .sidebar li.active a {
        color: var(--midnight);
        font-weight: 500;
      }

      /* Spans the whole frame so the illustration inside can stay stuck for the
         entire scroll, however long the page grows. Its resting position comes
         from --extra-offset on the image, not from the slot, because a sticky
         element can only travel within its container's content box. */
      .sidebar-extra-slot {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 2rem;
        width: 180px;
        pointer-events: none;
        user-select: none;
        z-index: 1;
      }

      .sidebar-extra-slot :global(.sidebar-cartoon) {
        display: block;
        width: 100%;
        height: auto;
        margin-top: var(--extra-offset, 18rem);
        /* Comes to rest just clear of the nav rather than sliding behind it:
           3rem of sidebar offset, ~9rem of nav, then breathing room. */
        position: sticky;
        top: 14rem;
      }

      .sidebar :global(.sidebar-cartoon) {
        display: block;
        width: 100%;
        height: auto;
        margin-top: 4rem;
        pointer-events: none;
        user-select: none;
      }

      .content {
        min-width: 0;
      }

      /* Tall strip in the right gutter, outside the content column but aligned
         to its top edge. Frame padding + sidebar + gap + content + gutter. */
      .aside-right-slot {
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(2rem + 180px + 3rem + 580px + 2.5rem);
        width: 120px;
        pointer-events: none;
        user-select: none;
        z-index: 1;
        display: none;
      }

      /* Below this the strip would crowd the viewport edge, so it is not rendered
         at all and the scene inside never starts. */
      @media (min-width: 1160px) {
        .aside-right-slot {
          display: block;
        }
      }

      .site-footer {
        max-width: 1100px;
        margin: 0 auto;
        padding: 4rem 2rem 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
        color: var(--cloudy-deep);
      }

      .site-footer .copy {
        margin: 0;
      }

      .site-footer .sep {
        margin: 0 0.4rem;
        color: var(--cloudy);
      }

      .site-footer .v1-link {
        color: var(--cloudy-deep);
        font-family: var(--font-serif);
        font-size: 0.72rem;
        font-weight: 500;
        text-decoration: none;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 1px;
        transition: color 0.15s ease, border-color 0.15s ease;
      }

      .site-footer .v1-link:hover {
        color: var(--midnight);
        border-color: var(--midnight);
      }

      .v1-wrap {
        position: relative;
        display: inline-block;
      }

      .v1-arrow {
        position: absolute;
        left: 100%;
        top: 50%;
        margin-left: 0.4rem;
        transform: translateY(-50%);
        width: 70px;
        height: 44px;
        color: var(--midnight);
        overflow: visible;
        pointer-events: none;
      }

      .socials-wrap {
        position: relative;
        display: inline-block;
      }

      .socials-arrow {
        position: absolute;
        right: 100%;
        top: 50%;
        margin-right: 0.4rem;
        transform: translateY(-50%);
        width: 70px;
        height: 44px;
        color: var(--midnight);
        overflow: visible;
        pointer-events: none;
      }

      .toast {
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%) translateY(8px);
        background: var(--ink);
        color: var(--pampas);
        font-family: var(--font-serif);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        padding: 0.55rem 0.95rem;
        border-radius: 999px;
        box-shadow: 0 10px 30px rgba(20, 18, 16, 0.22);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 200;
      }

      .toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      .menu-button {
        display: none;
      }

      /* Two 22x1.5px hairlines that rotate into the X. Two rather than three
         matches the weight of the rules elsewhere on the page. */
      .menu-lines {
        position: relative;
        display: block;
        width: 22px;
        height: 9px;
      }

      .menu-lines::before,
      .menu-lines::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 1.5px;
        background: currentColor;
        border-radius: 1px;
        transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      .menu-lines::before {
        top: 0;
      }

      .menu-lines::after {
        bottom: 0;
      }

      .menu-button[aria-expanded="true"] .menu-lines::before {
        transform: translateY(3.75px) rotate(45deg);
      }

      .menu-button[aria-expanded="true"] .menu-lines::after {
        transform: translateY(-3.75px) rotate(-45deg);
      }

      /* Opaque full-screen menu: repeats the header row at the same coordinates
         so opening reads as turning to a new page rather than a sheet sliding in. */
      .menu {
        position: fixed;
        inset: 0;
        z-index: 150;
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
        padding: calc(1.25rem + env(safe-area-inset-top)) 1.25rem
          calc(1.5rem + env(safe-area-inset-bottom));
        background: var(--pampas);
        color: var(--ink);
        overflow-y: auto;
        overscroll-behavior: contain;
        opacity: 0;
        transition: opacity 160ms ease;
      }

      .menu[hidden] {
        display: none;
      }

      .menu.is-open {
        opacity: 1;
        transition: opacity 220ms ease-out;
      }

      @media (min-width: 861px) {
        .menu {
          display: none !important;
        }
      }

      .menu-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .menu-top .signature {
        height: clamp(26px, 7.5vw, 32px);
      }

      .menu-close {
        width: 44px;
        height: 44px;
        margin-right: -11px;
        padding: 0;
        display: grid;
        place-items: center;
        background: none;
        border: 0;
        border-radius: 50%;
        color: var(--ink-soft);
        cursor: pointer;
        transition: color 0.15s ease;
      }

      .menu-close svg {
        width: 22px;
        height: 22px;
        display: block;
      }

      .menu-close:hover {
        color: var(--midnight);
      }

      .menu-close:focus-visible {
        outline: 2px solid var(--midnight);
        outline-offset: 2px;
      }

      .menu-nav {
        margin-top: 2.75rem;
      }

      .menu-nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .menu-nav a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.45rem 0;
        font-family: var(--font-serif);
        font-size: 2.1rem;
        line-height: 1.2;
        letter-spacing: -0.005em;
        color: var(--ink-soft);
        text-decoration: none;
      }

      .menu-nav .dot {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background: transparent;
        flex-shrink: 0;
      }

      .menu-nav li.active a {
        color: var(--midnight);
        font-weight: 500;
      }

      .menu-nav li.active .dot {
        background: var(--midnight);
      }

      .menu-nav a:focus-visible {
        outline: 2px solid var(--midnight);
        outline-offset: 4px;
        border-radius: 2px;
      }

      .menu-nav li {
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 300ms cubic-bezier(0.2, 0.8, 0.2, 1),
          transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      .menu.is-open .menu-nav li {
        opacity: 1;
        transform: none;
      }

      .menu.is-open .menu-nav li:nth-child(1) { transition-delay: 60ms; }
      .menu.is-open .menu-nav li:nth-child(2) { transition-delay: 95ms; }
      .menu.is-open .menu-nav li:nth-child(3) { transition-delay: 130ms; }
      .menu.is-open .menu-nav li:nth-child(4) { transition-delay: 165ms; }
      .menu.is-open .menu-nav li:nth-child(5) { transition-delay: 200ms; }

      .menu-foot {
        margin-top: auto;
        padding-top: 1.4rem;
        border-top: 1px solid var(--rule);
      }

      @media (max-width: 860px) {
        .brand {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 1.25rem 1.25rem 0;
          text-align: left;
        }

        .signature-mark,
        .signature-link {
          gap: 0.55rem;
        }

        .signature {
          height: 32px;
        }

        .signature-ar {
          height: 28px;
        }

        .signature-divider {
          width: 12px;
          height: 32px;
        }

        .brand-actions {
          display: flex;
          align-items: center;
          gap: 0.15rem;
        }

        .brand-actions :global(.header-theme) {
          width: 44px;
          height: 44px;
          justify-content: center;
          padding: 0;
          color: var(--ink-soft);
        }

        .brand-actions :global(.header-theme svg) {
          width: 18px;
          height: 18px;
        }

        .menu-button {
          display: grid;
          place-items: center;
          width: 44px;
          height: 44px;
          /* 22px of line centred in 44px, so the icon is flush with the edge. */
          margin-right: -11px;
          padding: 0;
          background: none;
          border: 0;
          border-radius: 50%;
          color: var(--ink-soft);
          cursor: pointer;
          transition: color 0.15s ease;
        }

        .menu-button:hover {
          color: var(--midnight);
        }

        .menu-button:focus-visible {
          outline: 2px solid var(--midnight);
          outline-offset: 2px;
        }

        .frame {
          grid-template-columns: 1fr;
          gap: 2rem;
          /* Content lines up with the signature above it. */
          padding: 2.25rem 1.25rem 3.5rem;
        }

        .sidebar,
        .sidebar-extra-slot {
          display: none;
        }

        .v1-arrow,
        .socials-arrow {
          display: none;
        }

        .site-footer {
          flex-direction: column;
          gap: 1.2rem;
          padding: 0 1.5rem 2.5rem;
          text-align: center;
        }
      }

      @media (max-width: 600px) {
        .signature {
          height: clamp(26px, 7.5vw, 32px);
        }

        .signature-ar,
        .signature-divider {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .menu {
          transition-duration: 120ms;
        }

        .menu-nav li {
          transform: none;
          transition: opacity 120ms ease;
          transition-delay: 0ms !important;
        }

        .menu-lines::before,
        .menu-lines::after {
          transition: none;
        }
      }
    </style>
  </body>
</html>
