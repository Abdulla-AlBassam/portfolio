---
import MinimalLayout from "@/layouts/MinimalLayout.astro";
import LinkModal from "@/components/LinkModal.astro";
---

<MinimalLayout title="Abdulla AlBassam's Portfolio" active="about" sidebarBottom="32rem">
  <img
    slot="sidebar-extra-bottom"
    src="/cartoon.webp"
    alt="Cartoon portrait of Abdulla AlBassam"
    class="sidebar-cartoon"
    width="220"
    height="220"
    loading="eager"
    decoding="async"
  />

  <section class="about">
    <img
      src="/cartoon-about-formal.webp"
      alt="Cartoon portrait of Abdulla AlBassam in traditional Saudi attire"
      class="cartoon cartoon-right"
      width="220"
      height="259"
      loading="eager"
      decoding="async"
    />
    <p>
      I work at the intersection of software development, cybersecurity and technology
      consulting. I graduated from
      <a href="https://www.northumbria.ac.uk/" target="_blank" rel="noopener noreferrer">Northumbria University</a>
      with First Class Honours in Networks and Cyber Security, supported by the
      <a href="https://sites.moe.gov.sa/scholarship-program/paths/path-arruaad/" target="_blank" rel="noopener noreferrer">Rwad</a>
      Scholarship.
    </p>

    <p>
      I'm the founder of
      <a href="https://blankstatelabs.com" target="_blank" rel="noopener noreferrer">Blank State Labs</a>,
      a Bahrain-based technology studio where I
      <a href="https://blankstatelabs.com" target="_blank" rel="noopener noreferrer">work with businesses</a>
      to understand their needs, shape ideas into practical solutions, and take them
      from initial concept through to secure delivery.
    </p>

    <p>
      I'm particularly interested in building technology that makes a difference:
      systems that simplify everyday work, solve meaningful problems and give people
      more time to focus on what matters. I'm also passionate about financial services
      and fintech, particularly the role of technology in shaping a more secure,
      connected and efficient financial industry. That interest has brought me to the
      <a href="https://www.cbb.gov.bh/" target="_blank" rel="noopener noreferrer">Central Bank of Bahrain</a>,
      where I'm currently a graduate trainee.
    </p>

    <p>
      Outside of work, I spend time building
      <a href="/projects/cybersecurity">agentic security tools</a>
      and working on
      <a href="https://sweatyapp.com" target="_blank" rel="noopener noreferrer">Sweaty</a>,
      a social platform for gamers.
    </p>

    <p>
      Earlier this year, my team and I received the Innovation Award at Northumbria's
      <button type="button" class="link-button" data-modal-trigger="hackathon">Anthropic × Accenture Hackathon</button>,
      where we developed an AI-driven digital solution addressing a real-world challenge
      affecting communities across the UK.
    </p>

    <h2 class="ledger-heading">Experience</h2>
    <ul class="ledger-list">
      <li class="ledger-entry">
        <p class="ledger-when">Oct 2026 – Present</p>
        <p class="ledger-title">
          <span>Graduate Trainee, GP15 Programme</span> <span class="ledger-org">Central Bank of Bahrain</span>
        </p>
      </li>
      <li class="ledger-entry">
        <p class="ledger-when">Oct 2026 – Present</p>
        <p class="ledger-title">
          <span>Founder &amp; Lead Developer</span>
          <span class="ledger-org"><a href="https://blankstatelabs.com" target="_blank" rel="noopener noreferrer">Blank State Labs</a></span>
        </p>
      </li>
      <li class="ledger-entry">
        <p class="ledger-when">Jul – Aug 2026</p>
        <p class="ledger-title">
          <span>Information Security</span> <span class="ledger-org">Investcorp</span>
          <span class="ledger-kind">Intern</span>
        </p>
      </li>
      <li class="ledger-entry">
        <p class="ledger-when">Jun – Aug 2026</p>
        <p class="ledger-title">
          <span>Software Engineering Consultant</span> <span class="ledger-org">JABA</span>
          <span class="ledger-kind">Freelance</span>
        </p>
      </li>
    </ul>

    <h2 class="ledger-heading">Education</h2>
    <ul class="ledger-list">
      <li class="ledger-entry">
        <p class="ledger-when">2023 – 2026</p>
        <p class="ledger-title">
          <span>BSc (Hons) Networks &amp; Cyber Security</span> <span class="ledger-org">Northumbria University</span>
        </p>
      </li>
      <li class="ledger-entry">
        <p class="ledger-when">2022 – 2023</p>
        <p class="ledger-title">
          <span>Economics &amp; Mathematics</span> <span class="ledger-org">King's College London</span>
        </p>
      </li>
      <li class="ledger-entry">
        <p class="ledger-when">2008 – 2022</p>
        <p class="ledger-title">
          <span>American Diploma with Honours</span> <span class="ledger-org">Modern Knowledge Schools, Bahrain</span>
        </p>
      </li>
    </ul>
  </section>

  <LinkModal
    id="hackathon"
    eyebrow="View project"
    title="Lean-in"
    subtitle="Anthropic × Accenture Hackathon · Innovation Award"
    links={[
      { label: "GitHub", href: "https://github.com/Abdulla-AlBassam/lean-in", icon: "github" },
      { label: "LinkedIn", href: "https://www.linkedin.com/feed/update/urn:li:activity:7459351820537274368/", icon: "linkedin" },
    ]}
    cert={{
      src: "/certs/hackathon.webp",
      alt: "Certificate of Achievement – Accenture Award for Innovation, Anthropic × Accenture Hackathon, Northumbria University, May 2026",
    }}
  />
</MinimalLayout>

<style>
  .about {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.65;
    position: relative;
  }

  .cartoon-right {
    position: absolute;
    top: -0.5rem;
    left: 100%;
    margin-left: 2rem;
    width: 220px;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 1080px) {
    .cartoon-right {
      display: none;
    }
  }

  /* Heading: small, sitting on a hairline that runs to the column edge */
  .ledger-heading {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 2.25rem 0 0.7rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: 0.005em;
    color: var(--ink);
  }

  /* An empty flex item takes its baseline from the bottom of its border box,
     so the rule lands on the word's baseline; the nudge clears the descenders. */
  .ledger-heading::after {
    content: "";
    flex: 1;
    border-bottom: 1px solid var(--rule);
    position: relative;
    top: 2px;
  }

  .ledger-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ledger-entry {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    column-gap: 1rem;
    align-items: baseline;
    padding: 0.42rem 0;
  }

  .ledger-entry p {
    margin: 0;
  }

  /* Date margin, tabular figures so the years stack cleanly */
  .ledger-when {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--cloudy-deep);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ledger-title {
    font-size: 0.92rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* Separators hang off the preceding span so they trail at a line end. */
  .ledger-title > span:not(:last-child)::after {
    content: " ·";
    color: var(--cloudy-deep);
  }

  .ledger-org {
    font-weight: 400;
    color: var(--midnight);
  }

  .ledger-kind {
    font-weight: 400;
    color: var(--ink-soft);
  }

  @media (max-width: 600px) {
    .ledger-entry {
      display: block;
      padding: 0.5rem 0;
    }

    .ledger-when {
      white-space: normal;
      margin-bottom: 0.05rem;
    }

    .ledger-title > span:not(:last-child)::after {
      content: ",";
      color: inherit;
    }
  }
</style>
