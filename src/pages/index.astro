---
import MinimalLayout from "@/layouts/MinimalLayout.astro";
import LinkModal from "@/components/LinkModal.astro";
---

<MinimalLayout title="Abdulla AlBassam's Portfolio" active="about" sidebarBottom="32rem">
  <img
    slot="sidebar-extra-bottom"
    src="/cartoon.webp"
    alt="Cartoon portrait of Abdulla AlBassam"
    class="sidebar-cartoon"
    width="220"
    height="220"
    loading="eager"
    decoding="async"
  />

  <section class="about">
    <img
      src="/cartoon-about-formal.webp"
      alt="Cartoon portrait of Abdulla AlBassam in traditional Saudi attire"
      class="cartoon cartoon-right"
      width="220"
      height="275"
      loading="eager"
      decoding="async"
    />
    <p>
      I'm a recent Cybersecurity and Networking graduate from
      <a href="https://www.northumbria.ac.uk/" target="_blank" rel="noopener noreferrer">Northumbria University</a>,
      with First Class Honours and a recipient of the
      <a href="https://sites.moe.gov.sa/scholarship-program/paths/path-arruaad/" target="_blank" rel="noopener noreferrer">Rwad</a>
      Scholarship, now specialising in AI Security.
    </p>

    <p>
      I'm engineering agentic security tools and researching how autonomous AI
      will reshape both sides of the cyber arms race.
    </p>

    <p>
      I'm also building <a href="https://sweatyapp.com" target="_blank" rel="noopener noreferrer">Sweaty</a>,
      a social platform for gamers.
    </p>

    <p>
      Recently, my team and I took home the Innovation Award at Northumbria's
      <button type="button" class="link-button" data-modal-trigger="hackathon">Anthropic × Accenture Hackathon</button>,
      where we built an AI-driven digital solution to a problem affecting the people of the UK.
    </p>

    <h2 class="ledger-heading">Experience</h2>
    <ul class="ledger-list">
      <li class="ledger-entry">
        <p class="ledger-when">Jul – Aug 2026</p>
        <p class="ledger-title">
          <span>Information Security Assurance</span> <span class="ledger-org">Investcorp</span>
          <span class="ledger-kind">Intern</span>
        </p>
      </li>
      <li class="ledger-entry">
        <p class="ledger-when">Jun – Aug 2026</p>
        <p class="ledger-title">
          <span>Software Engineering Consultant</span> <span class="ledger-org">JABA</span>
          <span class="ledger-kind">Freelance</span>
        </p>
      </li>
    </ul>

    <h2 class="ledger-heading">Education</h2>
    <ul class="ledger-list">
      <li class="ledger-entry">
        <p class="ledger-when">2023 – 2026<span class="ledger-note">First Class Honours.</span></p>
        <p class="ledger-title">
          <span>BSc (Hons) Networks &amp; Cyber Security</span> <span class="ledger-org">Northumbria University</span>
        </p>
      </li>
      <li class="ledger-entry">
        <p class="ledger-when">2022 – 2023<span class="ledger-note">Grade: 2:1.</span></p>
        <p class="ledger-title">
          <span>Foundation Year: Economics &amp; Mathematics</span> <span class="ledger-org">King's College London</span>
        </p>
      </li>
      <li class="ledger-entry">
        <p class="ledger-when">2008 – 2022<span class="ledger-note">Grade: 98%</span></p>
        <p class="ledger-title">
          <span>American Diploma with Honours</span> <span class="ledger-org">Modern Knowledge Schools, Bahrain</span>
        </p>
      </li>
    </ul>
  </section>

  <LinkModal
    id="hackathon"
    eyebrow="View project"
    title="Lean-in"
    subtitle="Anthropic × Accenture Hackathon · Innovation Award"
    links={[
      { label: "GitHub", href: "https://github.com/Abdulla-AlBassam/lean-in", icon: "github" },
      { label: "LinkedIn", href: "https://www.linkedin.com/feed/update/urn:li:activity:7459351820537274368/", icon: "linkedin" },
    ]}
    cert={{
      src: "/certs/hackathon.webp",
      alt: "Certificate of Achievement – Accenture Award for Innovation, Anthropic × Accenture Hackathon, Northumbria University, May 2026",
    }}
  />
</MinimalLayout>

<style>
  .about {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.65;
    position: relative;
  }

  .cartoon-right {
    position: absolute;
    top: -0.5rem;
    left: 100%;
    margin-left: 2rem;
    width: 220px;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 1080px) {
    .cartoon-right {
      display: none;
    }
  }

  /* Heading: small italic sitting on a hairline that runs to the column edge */
  .ledger-heading {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 2.25rem 0 0.7rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: 0.005em;
    color: var(--ink);
  }

  /* An empty flex item takes its baseline from the bottom of its border box,
     so the rule lands on the word's baseline; the nudge clears the descenders. */
  .ledger-heading::after {
    content: "";
    flex: 1;
    border-bottom: 1px solid var(--rule);
    position: relative;
    top: 2px;
  }

  .ledger-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ledger-entry {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    column-gap: 1rem;
    align-items: baseline;
    padding: 0.42rem 0;
  }

  .ledger-entry p {
    margin: 0;
  }

  /* Date margin, tabular figures so the years stack cleanly */
  .ledger-when {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--cloudy-deep);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Grade as a sidenote under the date */
  .ledger-note {
    display: block;
    font-style: italic;
  }

  .ledger-title {
    font-size: 0.92rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* Separators hang off the preceding span so they trail at a line end. */
  .ledger-title > span:not(:last-child)::after {
    content: " ·";
    color: var(--cloudy-deep);
  }

  .ledger-org {
    font-weight: 400;
    color: var(--midnight);
  }

  .ledger-kind {
    font-weight: 400;
    color: var(--ink-soft);
  }

  @media (max-width: 600px) {
    .ledger-entry {
      display: block;
      padding: 0.5rem 0;
    }

    .ledger-when {
      white-space: normal;
      margin-bottom: 0.05rem;
    }

    .ledger-note {
      display: inline;
    }

    .ledger-note::before {
      content: " · ";
      font-style: normal;
    }

    .ledger-title > span:not(:last-child)::after {
      content: ",";
      color: inherit;
    }
  }
</style>
