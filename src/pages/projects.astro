---
import MinimalLayout from "@/layouts/MinimalLayout.astro";
import { categories, projects } from "./projects/_projects";

const entries = categories.map((category) => ({
  ...category,
  count: projects.filter((p) => p.categories.includes(category.id)).length,
}));
---

<MinimalLayout title="Projects – Abdulla AlBassam" active="projects">
  <img slot="sidebar-extra" src="/cat.webp" alt="" class="sidebar-cartoon" />
  <section class="projects">
    <ul class="category-list">
      {
        entries.map((c) => (
          <li>
            <a class="category" href={`/projects/${c.id}`}>
              <span class="category-name">
                {c.label}
                <svg class="category-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </span>
              <span class="category-count">{c.count} projects</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</MinimalLayout>

<style is:global>
  body:has(.projects) .sidebar-cartoon {
    transform: translateX(-1rem);
  }
</style>

<style>
  /* One column of category names, each a link to its own page. The arrow is
     visible at rest so the names read as links on touch screens too. */
  .category-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .category {
    display: inline-block;
    color: var(--ink);
    text-decoration: none;
  }

  .category:focus-visible {
    outline: 2px solid var(--midnight);
    outline-offset: 6px;
  }

  .category-name {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.008em;
    transition: color 0.15s ease;
  }

  .category-arrow {
    color: var(--cloudy-deep);
    flex-shrink: 0;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .category-count {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--cloudy-deep);
    letter-spacing: 0.01em;
  }

  @media (hover: hover) {
    .category:hover .category-name {
      color: var(--midnight);
    }

    .category:hover .category-arrow {
      color: var(--midnight);
      transform: translateX(4px);
    }
  }

  @media (max-width: 860px) {
    .category-list {
      gap: 1.9rem;
    }

    .category-name {
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-name,
    .category-arrow {
      transition: none;
    }
  }
</style>
