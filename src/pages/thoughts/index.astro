---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { getThoughts } from "./_thoughts";

const thoughts = await getThoughts();
---

<MinimalLayout
  title="Thoughts – Abdulla AlBassam"
  description="Occasional writing on security, building things, and looking at things."
  active="thoughts"
>
  {
    thoughts.length > 0 && (
      <ul class="thought-grid">
        {thoughts.map((thought, i) => (
          <li>
            <a class="thought-card" href={`/thoughts/${thought.id}`}>
              <span class="thought-cover">
                <img
                  src={thought.data.cover}
                  alt={thought.data.coverAlt}
                  width="600"
                  height="600"
                  loading={i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </span>
              <span class="thought-title">{thought.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</MinimalLayout>

<style>
  .thought-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    row-gap: 2.5rem;
  }

  .thought-card {
    display: block;
    color: var(--ink);
    text-decoration: none;
    border-radius: 6px;
  }

  .thought-card:focus-visible {
    outline: 2px solid var(--midnight, #272757);
    outline-offset: 6px;
  }

  .thought-cover {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 6px;
    background: var(--pampas-deep);
  }

  .thought-cover img {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hairline keeps a dark photo from dissolving into the dark page. */
  .thought-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    pointer-events: none;
  }

  :global(html.dark) .thought-cover::after {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  .thought-title {
    display: block;
    margin: 0.8rem 0 0;
    font-family: var(--font-serif, "Newsreader", Georgia, serif);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: balance;
    transition: color 0.15s ease;
  }

  @media (hover: hover) {
    .thought-card:hover .thought-cover img {
      transform: scale(1.03);
    }

    .thought-card:hover .thought-title {
      color: var(--midnight, #272757);
    }
  }

  @media (max-width: 860px) {
    .thought-grid {
      column-gap: 1.1rem;
      row-gap: 1.6rem;
    }

    .thought-title {
      font-size: 0.98rem;
      margin-top: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thought-cover img,
    .thought-title {
      transition: none;
    }

    .thought-card:hover .thought-cover img {
      transform: none;
    }
  }
</style>
