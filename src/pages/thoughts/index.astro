---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { getThoughts, monthStamp, monthYear } from "./_thoughts";

const thoughts = await getThoughts();
---

<MinimalLayout
  title="Thoughts – Abdulla AlBassam"
  description="Occasional writing on security, building things, and looking at things."
  active="thoughts"
>
  {
    thoughts.length > 0 && (
      <ul class="thought-list">
        {thoughts.map((thought) => (
          <li>
            <a class="thought-card" href={`/thoughts/${thought.id}`}>
              <span class="thought-title">{thought.data.title}</span>
              <time class="thought-date" datetime={monthStamp(thought.data.date)}>
                {monthYear(thought.data.date)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</MinimalLayout>

<style>
  /* One column: each entry is its title and date, spaced apart, no rules between. */
  .thought-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .thought-card {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }

  .thought-card:focus-visible {
    outline: 2px solid var(--midnight, #272757);
    outline-offset: 6px;
  }

  .thought-title {
    display: block;
    margin: 0;
    font-family: var(--font-serif, "Newsreader", Georgia, serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.008em;
    text-wrap: balance;
    transition: color 0.15s ease;
  }

  .thought-date {
    display: block;
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--cloudy-deep);
    letter-spacing: 0.01em;
  }

  @media (hover: hover) {
    .thought-card:hover .thought-title {
      color: var(--midnight, #272757);
    }
  }

  @media (max-width: 860px) {
    .thought-list {
      gap: 1.9rem;
    }

    .thought-title {
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thought-title {
      transition: none;
    }
  }
</style>
