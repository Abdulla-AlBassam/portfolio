---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { getThoughts, monthStamp, monthYear } from "./_thoughts";

const thoughts = await getThoughts();
---

<MinimalLayout
  title="Thoughts – Abdulla AlBassam"
  description="Occasional writing on security, building things, and looking at things."
  active="thoughts"
>
  {
    thoughts.length > 0 && (
      <ul class="thought-list">
        {thoughts.map((thought, i) => (
          <li>
            <a class="thought-card" href={`/thoughts/${thought.id}`}>
              <span class="thought-title">{thought.data.title}</span>
              <time class="thought-date" datetime={monthStamp(thought.data.date)}>
                {monthYear(thought.data.date)}
              </time>
              <span class="thought-cover">
                <img
                  src={thought.data.cover}
                  alt={thought.data.coverAlt}
                  width="1800"
                  height="1200"
                  loading={i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</MinimalLayout>

<style>
  .thought-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .thought-card {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }

  .thought-card:focus-visible {
    outline: 2px solid var(--midnight, #272757);
    outline-offset: 6px;
  }

  .thought-title {
    display: block;
    margin: 0;
    font-family: var(--font-serif, "Newsreader", Georgia, serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.008em;
    text-wrap: balance;
    transition: color 0.15s ease;
  }

  .thought-date {
    display: block;
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--cloudy-deep);
    letter-spacing: 0.01em;
  }

  /* Landscape, square-cornered, the full width of the content column. */
  .thought-cover {
    display: block;
    position: relative;
    margin-top: 1.1rem;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--pampas-deep);
  }

  .thought-cover img {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hairline keeps a dark image from dissolving into the dark page. */
  .thought-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    pointer-events: none;
  }

  :global(html.dark) .thought-cover::after {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  @media (hover: hover) {
    .thought-card:hover .thought-cover img {
      transform: scale(1.03);
    }

    .thought-card:hover .thought-title {
      color: var(--midnight, #272757);
    }
  }

  @media (max-width: 860px) {
    .thought-list {
      gap: 2.5rem;
    }

    .thought-title {
      font-size: 1.2rem;
    }

    .thought-cover {
      margin-top: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thought-cover img,
    .thought-title {
      transition: none;
    }

    .thought-card:hover .thought-cover img {
      transform: none;
    }
  }
</style>
